// @polsia:user-owned — private first-chat records for personal accounts.

model Conversation {
  id              String   @id @default(cuid())
  userId          String
  title           String
  prompt          String
  assistantStatus String   @default("unavailable")
  assistantContent String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, updatedAt])
  @@map("conversation")
}
