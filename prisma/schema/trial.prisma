// @polsia:user-owned — personal free-trial entitlement. No workspace or membership link.

model FreeTrial {
  id        String   @id @default(cuid())
  userId    String   @unique
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("free_trial")
}
